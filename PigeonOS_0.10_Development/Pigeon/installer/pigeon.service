[Unit]
Description=Pigeon media display (@PIGEON_VERSION@)
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=@PIGEON_USER@
Group=@PIGEON_USER@
WorkingDirectory=@PIGEON_DIR@
Environment=HOME=@PIGEON_HOME@
Environment=DISPLAY=:0
Environment=XAUTHORITY=@PIGEON_HOME@/.Xauthority
Environment=PYTHONPYCACHEPREFIX=@PIGEON_DIR@/pigeonCashe
Environment=PIGEON_DISPLAY_W=1280
Environment=PIGEON_DISPLAY_H=800
Environment=PIGEON_WINDOW_SCALE=1.0
Environment=PIGEON_PI_FULLSCREEN=1
Environment=PIGEON_APPLE_TV_SCAN_TIMEOUT=12
# Start as soon as the graphical display exists; do not leave PiOS visible.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 0.1; done; exit 0'
ExecStart=@PIGEON_DIR@/installer/run_pigeon_0_10.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
